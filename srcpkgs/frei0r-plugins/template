# Template file for 'frei0r-plugins'
pkgname=frei0r-plugins
version=2.3.3
revision=1
build_style=cmake
makedepends="$(vopt_if gavl gavl-devel) $(vopt_if cairo cairo-devel) $(vopt_if opencv opencv-devel)"
short_desc="Minimalistic API for a collection of free video effects plugins"
maintainer="Orphaned <orphan@voidlinux.org>"
license="GPL-2.0-or-later"
homepage="http://frei0r.dyne.org/"
distfiles="https://github.com/dyne/frei0r/archive/refs/tags/v${version}.tar.gz"
checksum=aeeefe3a9b44761b2cf110017d2b1dfa2ceeb873da96d283ba5157380c5d0ce5

build_options="cairo gavl opencv"
build_options_default="cairo"
desc_option_cairo="required for cairo- filters and mixers"
desc_option_opencv="required for facebl0r filter"
desc_option_gavl="required for scale0tilt and vectorscope filters"
